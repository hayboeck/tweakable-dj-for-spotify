// Settings for Tweakable DJ. Everything after // is a comment and is ignored.
// Easiest to set up and change in the interface (double-click "Tweakable DJ.cmd" or "Tweakable DJ.command", on Linux ./start.sh). In a terminal: "node dj.mjs --dry" (preview only) or "node dj.mjs".
{
  // --- Credentials and source ---
  "spotify": { "clientId": "ENTER_CLIENT_ID_HERE" },                                   // Client ID from the Spotify Developer Dashboard
  "lastfm": { "apiKey": "ENTER_API_KEY_HERE", "user": "ENTER_LASTFM_USERNAME_HERE" },  // Last.fm API key and your Last.fm username ("" = without listening history)
  "seed": "liked",                    // Where your favorites come from: "liked" = Liked Songs, or a link to one of your own playlists

  // --- Playlist ---
  "playlistName": "Tweakable DJ",     // Name of the playlist to fill (created if it doesn't exist)

  // --- Length ---
  "size": 50,                         // Number of songs per run (1–500)

  // --- Selection ---
  "familiarShare": 0.15,              // Share of favorites (0–1; 0.15 = 15% ≈ 8 songs), the rest are new songs
  "adventure": 0.4,                   // 0–1: 0 = prefer similar songs, 0.5 = no preference, 1 = prefer distant ones; also the chance of detours to related artists
  "seedsPerRun": 20,                  // Number of starting points drawn per run, for which Last.fm finds similar songs (1–200)
  "useLastfmTopTracks": true,         // Also use your Last.fm top songs of the last 3 months as starting points
  "followedArtists": 0,               // Artists you follow on Spotify (-1–1): -1 = none of them, 0 = no preference (the list isn't even fetched), 1 = strongly preferred; applies to new songs and favorites
  "preferNewer": 0,                   // Newer or older songs by release year (-1–1): -1 = prefer older, 0 = no preference, 1 = prefer newer; only changes the odds, nothing is left out

  // --- What you're listening to right now ---
  "currentDays": 7,                   // "Current" = played within this many days (according to Last.fm; 0–365, 0 = off)
  "currentFactor": 3,                 // How much more current listening counts: for starting points, in the draw and for favorites (1–100, 1 = off)

  // --- Variety ---
  // In the interface, the slider "Artist variety" sets these four together (low, medium, high, very high; medium = the defaults here).
  "maxPerArtist": 2,                  // At most this many songs per artist in the whole playlist (1–500)
  "artistWindow": 20,                 // Window size for the rule below (1–100): any this many consecutive songs …
  "maxPerWindow": 3,                  // … contain at most this many songs related to the same artist (by them or found via them; 1–100)
  "artistGap": 4,                     // At least this many songs between two songs by the same artist (0–50, 0 = off)

  // --- No repeats ---
  "excludeRecentDays": 14,            // Songs you played within this many days are left out (0–365, 0 = off)
  "noRepeatRuns": 3,                  // Songs from this many previous runs are left out (0–100, 0 = off)

  // --- Block list ---
  "excludeExplicit": false,           // true = no songs with explicit lyrics (as marked by Spotify), neither as favorites nor as new songs
  "blockedArtists": [],               // Artists that are never played, e.g. ["Artist A", "Artist B"]
  "blockedTracks": [],                // Songs that are never played, also in other versions (at most 1000): [{ "uri": "spotify:track:…", "artist": "…", "name": "…" }]; easiest with × in the created list (tab “Playlist”)

  // --- Archive ---
  "archiveCount": 20,                 // After each write, the playlist is kept as a text file in the folder "archiv"; this many of the newest stay (0–200, 0 = off)

  // --- Automatic runs ---
  // Set this in the interface: only saving there adds Tweakable DJ to your computer's scheduler.
  "schedule": "off",                  // Recreate the playlist automatically: "off", "daily" or "weekly"
  "scheduleTime": "07:00",            // Time of day (24-hour clock, HH:MM)
  "scheduleDay": "MON",               // Day of the week for "weekly": "MON", "TUE", "WED", "THU", "FRI", "SAT" or "SUN"
  "notifyOnFailure": true,            // Show a system notification when an automatic run fails (e.g. Spotify login expired); false = off

  // --- Spotify login ---
  "remindLogin": true,                // Show a system notification one week before your Spotify login expires (it lasts 180 days), at most once a day; false = off

  // --- Shortcut ---
  // Set this in the interface (tab Settings → Shortcut): only saving there adds it to the desktop or removes it.
  "runShortcut": false,               // true = second shortcut “Tweakable DJ – Rebuild playlist”: rebuilds the playlist with a double-click, without the interface

  // --- Appearance ---
  "theme": "system",                  // Mode of the interface: "system" = like your device, "light" or "dark"
  "accent": "green",                  // Accent color of the interface: "green", "blue", "violet", "pink", "red", "orange", "gold" or "teal"
  "mode": "simple",                   // View of the tab Playlist: "simple" = only presets and number of songs, "pro" = all controls (without this line: "pro")

  // --- Language ---
  "language": ""                      // Language of the interface and output: "en" = English, "de" = German, "es" = Spanish, "fr" = French, "" = not chosen yet (system language)
}
