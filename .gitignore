# Persönliche Daten – dürfen nie hochgeladen werden
# deine Einstellungen mit Client ID und Last.fm-Schlüssel
config.jsonc
# deine Spotify-Anmeldung
tokens.json
# dein Verlauf und Such-Cache
state.json

# Automatisch angelegt
# Zwischenspeicher für Last.fm-Antworten (7 Tage gültig)
lastfm-cache.json
# Ergebnis des letzten Probelaufs, für „Diese Liste übernehmen“ bzw. node dj.mjs --apply (Songs, Zeitpunkt, Fingerabdruck der Einstellungen)
probelauf.json
# Ergebnis des letzten automatischen Laufs (das Protokoll automatik.log fällt unter *.log)
automatik.json
# Protokoll der Oberfläche ohne Fenster (ui.log, ältere Einträge in ui.old.log) – fällt ebenfalls unter *.log
# Ergebnis des letzten Laufs von „Playlist jetzt neu erstellen“ (zweite Verknüpfung; Protokoll jetzt.log unter *.log)
jetzt.json
# Letzte Prüfung auf neue Versionen (update.mjs)
update-check.json
# Zuletzt gesehene Version für den Hinweis „Neu in v…“ nach einem Update (whatsnew.mjs)
seen-version.json
# Arbeitsordner von „Jetzt aktualisieren“ (install-update.mjs): Zwischenablage und Sicherung der alten Programmdateien
.update/
# Playlist-Archiv: jede geschriebene Playlist als Textdatei (archive.mjs)
archiv/
# Zwischendatei beim Speichern einer persönlichen Datei (files.mjs); bleibt nur liegen, wenn das Programm genau dabei abbricht
.*.tmp

# System- und Editor-Dateien
.DS_Store
Thumbs.db
desktop.ini
.vscode/
node_modules/
*.log
